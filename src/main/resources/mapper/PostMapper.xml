<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.webapp.mapper.PostMapper">

    <!-- タグIDでタグ情報を取得するSQL -->
    <select id="findByTagId" resultType="com.example.webapp.entity.MoodTag">
        SELECT
            mood_tag_id         AS moodTagId,
            tag_name            AS tagName
        FROM mood_tags
        ORDER BY moodTagId
    </select>

</mapper>